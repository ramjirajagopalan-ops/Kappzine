# --- Database ---
# Self-hosted default (SQLite file on disk). Fine for Docker/VPS deployment
# where the filesystem persists between requests.
DATABASE_URL="file:./dev.db"
# For Vercel (serverless, ephemeral filesystem) swap to a hosted Postgres
# instead, e.g. Vercel Postgres / Neon / Supabase, and change the
# `provider` in prisma/schema.prisma from "sqlite" to "postgresql":
# DATABASE_URL="postgresql://user:password@host:5432/kappzine"

# --- Admin auth ---
# Plain password admin logs in with. Hash it yourself in production by
# setting ADMIN_PASSWORD_HASH instead (bcrypt hash) and omitting this.
ADMIN_PASSWORD="change-me"
# openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-string"

# --- File storage ---
# Leave unset for local-disk storage (self-hosted / Docker / VPS).
# Set this to enable Vercel Blob storage instead (required on Vercel,
# since serverless functions have a read-only, ephemeral filesystem):
# BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."
