# Copy this file to .env for local dev (docker-compose reads it too).

# --- Database -----------------------------------------------------------
DATABASE_URL="postgresql://kappzine:kappzine@localhost:5432/kappzine?schema=public"

# --- Auth (Auth.js / NextAuth v5) ---------------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-random-32-byte-secret"
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth — used both for "Sign in with Google" and for Drive storage
# access (the same consent screen grants both). See README.md > "Google
# Cloud setup" for the exact click-path to create these.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Enables a local username/password login so you can use the whole app
# before Google OAuth credentials exist. Set to "false" once real Google
# sign-in is wired up, or leave on for a self-hosted single-user setup.
ENABLE_DEV_LOGIN="true"
DEV_LOGIN_EMAIL="you@example.com"
DEV_LOGIN_PASSWORD="change-me"

# --- Storage --------------------------------------------------------------
# "local" writes processed files to disk (STORAGE_LOCAL_ROOT below).
# "gdrive" uploads to the signed-in user's Google Drive (requires the
# Google OAuth vars above and the user to have connected their account).
STORAGE_PROVIDER="local"
STORAGE_LOCAL_ROOT="./storage-data"

# --- App ------------------------------------------------------------------
APP_URL="http://localhost:3000"
